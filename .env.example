# Replace with a NEW Pinecone API key (the original key was exposed in the uploaded n8n JSON).
PINECONE_API_KEY=your_new_pinecone_api_key
PINECONE_ASSISTANT_URL=https://prod-1-data.ke.pinecone.io/assistant/chat/primechatbot
PINECONE_MODEL=gpt-4o

# Original n8n node: models/gemini-flash-lite-latest
GEMINI_API_KEY=your_google_gemini_api_key
GEMINI_MODEL=gemini-flash-lite-latest
USE_GEMINI=true

# Use the exact URL(s) of your frontend in production; comma-separated.
# '*' is convenient for local testing but should be restricted in production.
CORS_ORIGINS=*
